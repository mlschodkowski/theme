{
  "name": "MLS",
  "type": "dark",
  "colors": {
    "editor.background": "#0e0e0e",
    "editor.foreground": "#b2b2b2",
    "editorCursor.foreground": "#c9a470",
    "editor.selectionBackground": "#383838",
    "editor.lineHighlightBackground": "#1a1a1a",
    "editorLineNumber.foreground": "#44484e",
    "editorLineNumber.activeForeground": "#c9a470",
    "editorIndentGuide.background": "#25292e",
    "editorIndentGuide.activeBackground": "#44484e",
    "editorWhitespace.foreground": "#44484e",
    "editorBracketMatch.background": "#383838",
    "editorBracketMatch.border": "#c9a470",
    "editor.findMatchBackground": "#c9a470",
    "editor.findMatchForeground": "#0e0e0e",
    "editor.lineHighlightBorder": "#1a1a1a",
    "sideBar.background": "#111214",
    "sideBar.foreground": "#9ea1a5",
    "activityBar.background": "#111214",
    "activityBar.foreground": "#c9a470",
    "activityBar.inactiveForeground": "#585d76",
    "statusBar.background": "#111214",
    "statusBar.foreground": "#9ea1a5",
    "titleBar.activeBackground": "#111214",
    "titleBar.activeForeground": "#b2b2b2",
    "tab.activeBackground": "#0e0e0e",
    "tab.activeForeground": "#b2b2b2",
    "tab.inactiveBackground": "#111214",
    "tab.inactiveForeground": "#585d76",
    "panel.background": "#111214",
    "panel.border": "#1a1a1a",
    "focusBorder": "#c9a470",
    "input.background": "#1c1f23",
    "input.foreground": "#b2b2b2",
    "list.activeSelectionBackground": "#383838",
    "list.activeSelectionForeground": "#b2b2b2",
    "list.hoverBackground": "#25292e",
    "list.highlightForeground": "#c9a470",
    "quickInput.background": "#111214",
    "quickInput.foreground": "#b2b2b2",
    "terminal.background": "#0e0e0e",
    "terminal.foreground": "#b2b2b2",
    "terminalCursor.foreground": "#c9a470",
    "terminal.selectionBackground": "#383838",
    "gitDecoration.addedResourceForeground": "#96b970",
    "gitDecoration.modifiedResourceForeground": "#c9a470",
    "gitDecoration.deletedResourceForeground": "#df7e90",
    "editorError.foreground": "#df7e90",
    "editorWarning.foreground": "#c9a470",
    "editorInfo.foreground": "#85c3e8",
    "editorHint.foreground": "#79c5b9"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#585d76", "fontStyle": "italic" } },
    { "scope": ["string", "constant.character"], "settings": { "foreground": "#96b970" } },
    { "scope": ["constant.character.escape", "constant.escape"], "settings": { "foreground": "#85c3e8" } },
    { "scope": ["constant.numeric", "constant.language", "support.constant", "variable.other.constant"], "settings": { "foreground": "#e49b70" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#b69de5" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#b2b2b2" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#82a0e0" } },
    { "scope": ["keyword.operator", "punctuation.accessor", "punctuation.definition.annotation", "punctuation.definition.decorator"], "settings": { "foreground": "#c9a470" } },
    { "scope": ["entity.name.tag", "entity.other.attribute-name", "markup.heading"], "settings": { "foreground": "#82a0e0" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#df7e90", "fontStyle": "bold" } }
  ]
}
