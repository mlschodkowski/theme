        "version_control.modified": "#c9a470ff",
        "version_control.deleted": "#df7e90ff",
        "terminal.background": "#0e0e0eff",
        "terminal.foreground": "#b2b2b2ff",
        "terminal.bright_foreground": "#c8c8c8ff",
        "terminal.dim_foreground": "#6f747bff",
        "terminal.ansi.black": "#0a0a0aff",
        "terminal.ansi.bright_black": "#585d76ff",
        "terminal.ansi.red": "#df7e90ff",
        "terminal.ansi.bright_red": "#df7e90ff",
        "terminal.ansi.green": "#96b970ff",
        "terminal.ansi.bright_green": "#96b970ff",
        "terminal.ansi.yellow": "#c9a470ff",
        "terminal.ansi.bright_yellow": "#c9a470ff",
        "terminal.ansi.blue": "#8993a3ff",
        "terminal.ansi.bright_blue": "#b2b2b2ff",
        "terminal.ansi.magenta": "#b69de5ff",
        "terminal.ansi.bright_magenta": "#b69de5ff",
        "terminal.ansi.cyan": "#85c3e8ff",
        "terminal.ansi.bright_cyan": "#85c3e8ff",
        "terminal.ansi.white": "#b2b2b2ff",
        "terminal.ansi.bright_white": "#c8c8c8ff",
        "syntax": {
          "attribute": { "color": "#82a0e0ff" },
          "comment": { "color": "#585d76ff", "font_style": "italic" },
