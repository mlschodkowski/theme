{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "MLS",
  "author": "mlschodkowski, adapted from xai-org/grok-build",
  "themes": [
    {
      "name": "MLS",
      "appearance": "dark",
      "style": {
        "background": "#0e0e0eff",
        "surface.background": "#111214ff",
        "panel.background": "#111214ff",
        "title_bar.background": "#111214ff",
        "title_bar.inactive_background": "#0e0e0eff",
        "status_bar.background": "#111214ff",
        "toolbar.background": "#111214ff",
        "tab_bar.background": "#111214ff",
        "tab.inactive_background": "#111214ff",
        "tab.active_background": "#0e0e0eff",
        "border": "#1a1a1aff",
        "border.variant": "#1a1a1aff",
        "border.focused": "#c9a470ff",
        "border.selected": "#c9a470ff",
        "panel.focused_border": "#c9a470ff",
        "pane.focused_border": "#c9a470ff",
        "element.background": "#1c1f23ff",
        "element.hover": "#25292eff",
        "element.active": "#25292eff",
        "element.selected": "#383838ff",
        "text": "#b2b2b2ff",
        "text.muted": "#9ea1a5ff",
        "text.placeholder": "#585d76ff",
        "text.disabled": "#44484eff",
        "text.accent": "#c9a470ff",
        "icon": "#b2b2b2ff",
        "icon.muted": "#9ea1a5ff",
        "icon.disabled": "#44484eff",
        "icon.accent": "#c9a470ff",
        "editor.background": "#0e0e0eff",
        "editor.foreground": "#b2b2b2ff",
        "editor.gutter.background": "#0e0e0eff",
        "editor.line_number": "#44484eff",
        "editor.active_line_number": "#c9a470ff",
        "editor.active_line.background": "#1a1a1aff",
        "editor.highlighted_line.background": "#1a1a1aff",
        "editor.indent_guide": "#25292eff",
        "editor.indent_guide_active": "#44484eff",
        "editor.invisible": "#25292eff",
        "editor.selection.background": "#38383880",
        "search.match_background": "#c9a47055",
        "search.active_match_background": "#c9a47080",
        "cursor": "#c9a470ff",
        "link_text.hover": "#829bc8ff",
        "error": "#df7e90ff",
        "warning": "#c9a470ff",
        "hint": "#79c5b9ff",
        "info": "#85c3e8ff",
        "success": "#96b970ff",
