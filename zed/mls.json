          "constant.builtin": { "color": "#e49b70ff" },
          "constructor": { "color": "#82a0e0ff" },
          "function": { "color": "#b2b2b2ff" },
          "keyword": { "color": "#b69de5ff" },
          "operator": { "color": "#c9a470ff" },
          "punctuation": { "color": "#585d76ff" },
          "string": { "color": "#96b970ff" },
          "string.escape": { "color": "#85c3e8ff" },
          "type": { "color": "#82a0e0ff" },
          "tag": { "color": "#82a0e0ff" },
          "variable": { "color": "#b2b2b2ff" },
          "number": { "color": "#e49b70ff" },
          "boolean": { "color": "#e49b70ff" },
          "invalid": { "color": "#df7e90ff" }
