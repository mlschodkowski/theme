{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Nordic MLS",
  "author": "mlschodkowski, adapted from AlexvZyl/nordic.nvim",
  "themes": [
    {
      "name": "Nordic MLS",
      "appearance": "dark",
      "style": {
        "background": "#242933ff",
        "surface.background": "#1E222Aff",
        "panel.background": "#1E222Aff",
        "title_bar.background": "#1E222Aff",
        "title_bar.inactive_background": "#242933ff",
        "status_bar.background": "#1E222Aff",
        "toolbar.background": "#1E222Aff",
        "tab_bar.background": "#1E222Aff",
        "tab.inactive_background": "#1E222Aff",
        "tab.active_background": "#242933ff",
        "border": "#1E222Aff",
        "border.variant": "#1E222Aff",
        "border.focused": "#EBCB8Bff",
        "border.selected": "#EBCB8Bff",
        "panel.focused_border": "#EBCB8Bff",
        "pane.focused_border": "#EBCB8Bff",
        "element.background": "#2E3440ff",
        "element.hover": "#333A48ff",
        "element.active": "#333A48ff",
        "element.selected": "#434C5Eff",
        "text": "#BBC3D4ff",
        "text.muted": "#9CA7C0ff",
        "text.placeholder": "#60728Aff",
        "text.disabled": "#4C566Aff",
        "text.accent": "#EBCB8Bff",
        "icon": "#BBC3D4ff",
        "icon.muted": "#9CA7C0ff",
        "icon.disabled": "#4C566Aff",
        "icon.accent": "#EBCB8Bff",
        "editor.background": "#242933ff",
        "editor.foreground": "#BBC3D4ff",
        "editor.gutter.background": "#242933ff",
        "editor.line_number": "#4C566Aff",
        "editor.active_line_number": "#EBCB8Bff",
        "editor.active_line.background": "#2E3440ff",
        "editor.highlighted_line.background": "#2E3440ff",
        "editor.indent_guide": "#333A48ff",
        "editor.indent_guide_active": "#4C566Aff",
        "editor.invisible": "#333A48ff",
        "editor.selection.background": "#434C5E80",
        "search.match_background": "#EBCB8B55",
        "search.active_match_background": "#EBCB8B80",
        "cursor": "#EBCB8Bff",
        "link_text.hover": "#81A1C1ff",
        "error": "#BF616Aff",
        "warning": "#EBCB8Bff",
        "hint": "#8FBCBBff",
        "info": "#88C0D0ff",
        "success": "#A3BE8Cff",
        "version_control.added": "#A3BE8Cff",
        "version_control.modified": "#EBCB8Bff",
        "version_control.deleted": "#BF616Aff",
        "terminal.background": "#242933ff",
        "terminal.foreground": "#BBC3D4ff",
        "terminal.bright_foreground": "#ECEFF4ff",
        "terminal.dim_foreground": "#60728Aff",
        "terminal.ansi.black": "#3B4252ff",
        "terminal.ansi.bright_black": "#4C566Aff",
        "terminal.ansi.red": "#BF616Aff",
        "terminal.ansi.bright_red": "#BF616Aff",
        "terminal.ansi.green": "#A3BE8Cff",
        "terminal.ansi.bright_green": "#A3BE8Cff",
        "terminal.ansi.yellow": "#EBCB8Bff",
        "terminal.ansi.bright_yellow": "#EBCB8Bff",
        "terminal.ansi.blue": "#81A1C1ff",
        "terminal.ansi.bright_blue": "#81A1C1ff",
        "terminal.ansi.magenta": "#B48EADff",
        "terminal.ansi.bright_magenta": "#B48EADff",
        "terminal.ansi.cyan": "#88C0D0ff",
        "terminal.ansi.bright_cyan": "#88C0D0ff",
        "terminal.ansi.white": "#E5E9F0ff",
        "terminal.ansi.bright_white": "#ECEFF4ff",
        "syntax": {
          "attribute": { "color": "#81A1C1ff" },
          "comment": { "color": "#60728Aff", "font_style": "italic" },
          "constant": { "color": "#D08770ff" },
          "constant.builtin": { "color": "#D08770ff" },
          "constructor": { "color": "#81A1C1ff" },
          "function": { "color": "#BBC3D4ff" },
          "keyword": { "color": "#B48EADff" },
          "operator": { "color": "#EBCB8Bff" },
          "punctuation": { "color": "#60728Aff" },
          "string": { "color": "#A3BE8Cff" },
          "string.escape": { "color": "#88C0D0ff" },
          "type": { "color": "#81A1C1ff" },
          "tag": { "color": "#81A1C1ff" },
          "variable": { "color": "#BBC3D4ff" },
          "number": { "color": "#D08770ff" },
          "boolean": { "color": "#D08770ff" },
          "invalid": { "color": "#BF616Aff" }
        }
      }
    }
