{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Carbon",
  "author": "Adapted from rishikanthc/carbon-helix",
  "themes": [
    {
      "name": "Carbon",
      "appearance": "dark",
      "style": {
        "background": "#161616ff",
        "surface.background": "#262626ff",
        "panel.background": "#161616ff",
        "title_bar.background": "#262626ff",
        "title_bar.inactive_background": "#161616ff",
        "status_bar.background": "#262626ff",
        "toolbar.background": "#161616ff",
        "tab_bar.background": "#262626ff",
        "tab.inactive_background": "#262626ff",
        "tab.active_background": "#161616ff",
        "border": "#393939ff",
        "border.variant": "#393939ff",
        "border.focused": "#4589ffff",
        "border.selected": "#4589ffff",
        "panel.focused_border": "#4589ffff",
        "pane.focused_border": "#4589ffff",
        "element.background": "#262626ff",
