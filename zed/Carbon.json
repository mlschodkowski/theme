          "constructor": { "color": "#be95ffff", "font_weight": 700 },
          "constant": { "color": "#3ddbd9ff" },
          "string": { "color": "#a7f0baff" },
          "comment": { "color": "#525252ff", "font_style": "italic" },
          "variable": { "color": "#a8a8a8ff" },
          "parameter": { "color": "#ff9ec7ff", "font_style": "italic" },
          "property": { "color": "#ff7eb6ff", "font_style": "italic" },
          "keyword": { "color": "#82cfffff", "font_weight": 700 },
          "operator": { "color": "#82cfffff" },
          "function": { "color": "#78a9ffff", "font_weight": 700 },
