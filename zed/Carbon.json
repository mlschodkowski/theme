        "icon.disabled": "#525252ff",
        "icon.accent": "#78a9ffff",
        "editor.background": "#161616ff",
        "editor.foreground": "#a8a8a8ff",
        "editor.gutter.background": "#161616ff",
        "editor.line_number": "#525252ff",
        "editor.active_line_number": "#c8ccd4ff",
        "editor.active_line.background": "#262626ff",
        "editor.highlighted_line.background": "#262626ff",
        "editor.indent_guide": "#393939ff",
        "editor.indent_guide_active": "#525252ff",
        "editor.invisible": "#393939ff",
        "editor.selection.background": "#393939ff",
        "search.match_background": "#f1c21b55",
        "search.active_match_background": "#f1c21b99",
        "cursor": "#82cfffff",
        "link_text.hover": "#4589ffff",
        "error": "#ff7eb6ff",
        "warning": "#f1c21bff",
        "hint": "#3ddbd9ff",
