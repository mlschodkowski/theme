          "boolean": { "color": "#3ddbd9ff" },
          "label": { "color": "#78a9ffff", "font_style": "italic" },
          "namespace": { "color": "#08bdbaff", "font_style": "italic" },
          "selector": { "color": "#3ddbd9ff" },
          "variant": { "color": "#ff9ec7ff" },
          "embedded": { "color": "#08bdbaff" },
          "emphasis": { "color": "#be95ffff", "font_style": "italic" },
